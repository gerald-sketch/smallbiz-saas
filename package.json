{
  "name": "smallbiz-saas",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "deepmerge-ts": "^8.0.1",
    "mysql2": "^3.23.1",
    "tailwindcss": "3.4.19"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "@prisma/client@7.10.0": true,
    "bcrypt@6.0.0": true
  },
  "scripts": {
    "dev": "concurrently -n shared,api,web -c yellow,blue,green \"npm -w packages/shared run dev\" \"npm -w apps/api run dev\" \"npm -w apps/web run dev\"",
    "build": "npm -w packages/shared run build && npm -w apps/api run build && npm -w apps/web run build",
    "db:migrate": "npm -w apps/api run db:migrate",
    "db:studio": "npm -w apps/api run db:studio"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^5.5.0"
  }
}
